# 1️ Create an empty dictionary
d = {}
print(d)

# 2️ Create dictionary using dict() method
d1 = dict({})
print(d1)

# 3️ Create a dictionary with values
d2 = {"Name": "Swathi", "Course": "BCA", "Age": 18}
print(d2)

# 4️ Dictionary with list values
d3 = {
    'name': ['Swathi', 'Swan', 'Sam'],
    'course': ['BCA', 'BSc', 'B.Com']
}

print(d3)

# Dictionary Methods
# 1. keys() - returns all keys
# 2. values() - returns all values
# 3. items() - returns key-value pairs

print(d3.keys())
print(d3.values())
print(d3.items())


# 5️ get() method example
student = {
    "name": "Ravi",
    "age": 20,
    "course": "BCA"
}

print(student.get("name"))      # returns value
print(student.get("marks"))     # returns None
print(student.get("marks", 0))  # default value


# 6️ Modifying dictionary elements

# Add new key-value pair
student["grade"] = "A"
print(student)


# 7️ Removing elements

# del keyword
del student["course"]
print(student)

# pop() - removes specified key
student.pop("age")
print(student)

# popitem() - removes last inserted key-value pair
student.popitem()
print(student)


# 8️ update() method
student.update({"age": 24, "city": "Bengaluru"})
print(student)
